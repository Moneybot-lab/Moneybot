{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-atlas-v4-prospective-feature-snapshot.v1",
  "title": "Alpha Atlas V4 prospective feature snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "cohort_session_id", "ticker", "point_in_time_symbol_id", "universe_manifest_id", "universe_manifest_sha256", "snapshot_id", "attempt_id", "feature_definition_version", "feature_vector", "feature_vector_sha256", "provenance_sha256", "code_commit", "configuration_sha256", "feature_cutoff_at", "assembly_started_at", "assembly_completed_at", "persistence_completed_at", "ready_for_use_at", "scheduled_decision_at", "families", "missing_features", "errors", "lateness", "status", "eligibility_reason_codes"],
  "properties": {
    "schema_version": {"const": "alpha-atlas-v4-prospective-feature-snapshot.v1"},
    "contract_version": {"const": "alpha-atlas-v4-prospective-snapshot-capture-contract.v1"},
    "cohort_session_id": {"type": "string", "minLength": 1},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9.-]+$"},
    "point_in_time_symbol_id": {"type": ["string", "null"]},
    "universe_manifest_id": {"type": "string"},
    "universe_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_id": {"type": "string", "pattern": "^aav4snap_[0-9a-f]{64}$"},
    "attempt_id": {"type": "string"},
    "supersedes_snapshot_id": {"type": ["string", "null"]},
    "feature_definition_version": {"const": "alpha-atlas-v4-features.v2"},
    "feature_vector": {"type": "object", "additionalProperties": {"type": ["number", "integer", "string", "boolean", "null"]}},
    "feature_vector_sha256": {"$ref": "#/$defs/sha256"},
    "provenance_sha256": {"$ref": "#/$defs/sha256"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "feature_cutoff_at": {"$ref": "#/$defs/timestamp"},
    "assembly_started_at": {"$ref": "#/$defs/timestamp"},
    "assembly_completed_at": {"$ref": "#/$defs/timestamp"},
    "persistence_completed_at": {"$ref": "#/$defs/timestamp"},
    "ready_for_use_at": {"$ref": "#/$defs/timestamp"},
    "scheduled_decision_at": {"$ref": "#/$defs/timestamp"},
    "families": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/family"}},
    "missing_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "errors": {"type": "array", "items": {"type": "string"}},
    "lateness": {"type": "object", "required": ["deadline_at", "completion_late", "ready_late", "clock_uncertainty_ms"], "properties": {"deadline_at": {"$ref": "#/$defs/timestamp"}, "completion_late": {"type": "boolean"}, "ready_late": {"type": "boolean"}, "clock_uncertainty_ms": {"type": ["integer", "null"], "minimum": 0}}, "additionalProperties": false},
    "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED"]},
    "eligibility_reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_version", "source_object_id", "source_content_sha256", "source_event_at", "source_received_at", "receipt_evidence_kind", "freshness_sessions", "freshness_status", "missing_features", "error_codes"],
      "properties": {
        "definition_version": {"type": "string"},
        "source_object_id": {"type": ["string", "null"]},
        "source_content_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "source_event_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "source_received_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "receipt_evidence_kind": {"enum": ["PROVIDER_TIMESTAMP", "COLLECTOR_RECEIPT_CLOCK", "SIGNED_SOURCE_MANIFEST", "UNKNOWN"]},
        "freshness_sessions": {"type": ["integer", "null"], "minimum": 0},
        "freshness_status": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
        "missing_features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "error_codes": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "x-synthetic-example-not-observed-evidence": {
